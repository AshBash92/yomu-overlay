{
  "manifest_version": 3,
  "name": "Yomu Overlay",
  "version": "0.1.0",
  "description": "Translate Japanese manga on screen into English with Claude, and learn kanji as you read.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Yomu Overlay",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-visible": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate what's visible in this tab"
    },
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Show or hide the translation overlays"
    },
    "reveal-english": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Show or hide English for every bubble (read-first and hover modes)"
    },
    "open-study-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the study panel"
    }
  }
}
